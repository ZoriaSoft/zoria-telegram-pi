    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
