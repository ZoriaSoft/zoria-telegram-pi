{
  "name": "zoria-telegram-pi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pi coding agent'ı Telegram üzerinden kontrol et",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "lint": "oxlint src scripts tests",
    "test": "vitest run",
    "verify": "npm run build && npm run lint && npm run test",
    "selftest": "tsx scripts/selftest.ts"
  },
  "dependencies": {
