# Telegram bot token (BotFather'dan: /newbot)
BOT_TOKEN=

# Çalışmasına izin verilen Telegram kullanıcı ID'leri (virgülle ayrılmış)
# KENDI user_id'nizi yazın — @userinfobot'dan öğrenebilirsiniz.
ALLOWED_IDS=

# Bot'un pi oturumlarını açacağı çalışma kökü (projelerin bulunduğu dizin)
WORKSPACE_ROOT=/home/workspace

# Pi modeli (önerilen: zai/glm-5.3 — AGENTS.md DNA default'u)
PI_MODEL=zai/glm-5.3
SUPERVISOR_CONF=/etc/zo/supervisord-user.conf
